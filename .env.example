# Copy to .env and fill in. Never commit .env.

# LLM: OpenAI-compatible endpoint (9router / omniroute).
# Inside Docker, use host.docker.internal to reach a service on the host.
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_API_KEY=
LLM_MODEL=

# Vector database (compose service name; use :memory: for local unit runs)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hotel_docs

# Embeddings (local, multilingual)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=/models

# Abstention threshold for grounded answers
ABSTAIN_MIN_SCORE=0.3
